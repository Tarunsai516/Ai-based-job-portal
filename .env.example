# Copy this file to .env and replace the values locally.
ADMIN_NAME=Your Name
ADMIN_EMAIL=your-private-admin-email@example.com
ADMIN_PASSWORD=replace-with-a-long-random-password

# AI provider. Keep the key server-side and never expose it to Vite/frontend code.
AI_PROVIDER=openai
AI_API_KEY=replace-with-your-openai-key
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000,http://localhost:80

# Local MySQL backend connection. Set these when running Spring Boot outside Docker.
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/talentsync?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&createDatabaseIfNotExist=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=replace-with-your-mysql-password